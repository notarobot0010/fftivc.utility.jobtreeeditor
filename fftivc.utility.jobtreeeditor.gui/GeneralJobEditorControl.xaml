<UserControl x:Class="fftivc.utility.jobtreeeditor.gui.GeneralJobEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:fftivc.utility.jobtreeeditor.gui"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Shared style for neighbor combo boxes (compact) -->
        <Style x:Key="NeighborCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="130"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Muted style for fallback combos -->
        <Style x:Key="FallbackCombo" TargetType="ComboBox" BasedOn="{StaticResource NeighborCombo}">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <!-- Direction label -->
        <Style x:Key="DirLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Fallback label -->
        <Style x:Key="FallbackLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="250"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Job list grid + bottom buttons -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" x:Name="GjGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="GjGrid_SelectionChanged"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                      BorderBrush="{DynamicResource PanelBorder}"
                      Background="{DynamicResource GridBg}"
                      RowBackground="{DynamicResource GridBg}"
                      AlternatingRowBackground="{DynamicResource GridAltRowBg}"
                      Foreground="{DynamicResource TextPrimary}"
                      FontSize="12">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
                        <Setter Property="Foreground" Value="{DynamicResource GridHeaderFg}"/>
                        <Setter Property="Padding" Value="6,5"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="4,3"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource GridSelectionBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GridSelectionFg}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource GridSelectionBg}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="35"/>
                    <DataGridTextColumn Header="Job" Binding="{Binding Name}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Prereqs" Binding="{Binding PrereqSummary}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="" Width="25">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="●" Foreground="{DynamicResource ModifiedDot}" FontSize="10"
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding IsModified,
                                               Converter={StaticResource BoolToVis}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Reset Neighbors" Style="{StaticResource ActionButton}"
                        Click="ResetNeighbors_Click" FontSize="11"/>
                <Button Content="Reset All" Style="{StaticResource ActionButton}"
                        Margin="6,0,0,0" Click="ResetAll_Click" FontSize="11"/>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource PanelBorder}" Cursor="SizeWE"/>

        <!-- RIGHT: Edit panel (scrollable) -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="EDIT JOB"/>

                    <!-- Row 1: Job selector + Comment -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Job:" Foreground="{DynamicResource TextPrimary}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="GjJobSelector" Width="180"
                                      SelectionChanged="GjJobSelector_Changed" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayLabel}" Foreground="{DynamicResource TextPrimary}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Comment:" Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="CommentBox" Width="300" VerticalAlignment="Center"
                                     Padding="4,3" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Row 2: Prerequisites (collapsible, expanded by default) -->
                    <Expander Grid.Row="2" Header="PREREQUISITES" IsExpanded="True" Margin="0,4,0,4"
                              Foreground="{DynamicResource TextPrimary}">
                        <StackPanel Margin="0,4,0,8">
                            <DataGrid x:Name="PrereqGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                                      BorderBrush="{DynamicResource PanelBorder}"
                                      Background="{DynamicResource GridBg}"
                                      RowBackground="{DynamicResource GridBg}"
                                      Foreground="{DynamicResource TextPrimary}"
                                      MaxHeight="140"
                                      FontSize="12"
                                      Margin="0,0,0,6">

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource GridHeaderFg}"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Required Job" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RequiredJobDisplay}" Padding="4,2"
                                                    Foreground="{DynamicResource TextPrimary}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedIndex="{Binding RequiredJobIndex, UpdateSourceTrigger=PropertyChanged}"
                                                    ItemsSource="{Binding JobOptions}"
                                                    IsDropDownOpen="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Level" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RequiredLevel}" Padding="4,2"
                                                    Foreground="{DynamicResource TextPrimary}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding RequiredLevel, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Label Position" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PositionDisplay}" Padding="4,2"
                                                    Foreground="{DynamicResource TextPrimary}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedIndex="{Binding PositionIndex, UpdateSourceTrigger=PropertyChanged}"
                                                    ItemsSource="{Binding PositionOptions}"
                                                    IsDropDownOpen="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add Prerequisite" Style="{StaticResource ActionButton}"
                                        Click="AddPrereq_Click" Margin="0,0,8,0"/>
                                <Button Content="Remove Selected" Style="{StaticResource ActionButton}"
                                        Click="RemovePrereq_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Row 3: Cursor Neighbors (collapsible, collapsed by default) -->
                    <Expander Grid.Row="3" Header="CURSOR NEIGHBORS" IsExpanded="False" Margin="0,4,0,4"
                              Foreground="{DynamicResource TextPrimary}">

                        <!-- Compass-style neighbor grid -->
                        <Grid Margin="0,4,0,8" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Legend (column 4) -->
                            <StackPanel Grid.Row="0" Grid.Column="4" Grid.RowSpan="11" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="Primary" Foreground="{DynamicResource TextPrimary}" FontSize="10" Margin="0,0,0,2"/>
                                <TextBlock Text="Fallback" Foreground="{DynamicResource TextMuted}" FontSize="10" FontStyle="Italic"/>
                            </StackPanel>

                            <!-- Top row: Up-Left, Up, Up-Right -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Up-Left" Style="{StaticResource DirLabel}"/>
                                <ComboBox x:Name="UpLeftNeighborBox" Style="{StaticResource NeighborCombo}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="Up" Style="{StaticResource DirLabel}"/>
                                <ComboBox x:Name="UpNeighborBox" Style="{StaticResource NeighborCombo}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Up-Right" Style="{StaticResource DirLabel}"/>
                                <ComboBox x:Name="UpRightNeighborBox" Style="{StaticResource NeighborCombo}"/>
                            </StackPanel>

                            <!-- Top row fallbacks -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="fallback" Style="{StaticResource FallbackLabel}"/>
                                <ComboBox x:Name="UpLeftFallbackBox" Style="{StaticResource FallbackCombo}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="fallback" Style="{StaticResource FallbackLabel}"/>
                                <ComboBox x:Name="UpFallbackBox" Style="{StaticResource FallbackCombo}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="fallback" Style="{StaticResource FallbackLabel}"/>
                                <ComboBox x:Name="UpRightFallbackBox" Style="{StaticResource FallbackCombo}"/>
                            </StackPanel>

                            <!-- Middle row: Left, (job label), Right -->
                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="Left" Style="{StaticResource DirLabel}"/>
                                <ComboBox x:Name="LeftNeighborBox" Style="{StaticResource NeighborCombo}"/>
                            </StackPanel>
                            <Border Grid.Row="4" Grid.Column="1" Grid.RowSpan="2"
                                    Background="{DynamicResource InputBg}" CornerRadius="4"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Padding="12,6">
                                <TextBlock x:Name="CompassCenterLabel" Text="Job" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="Right" Style="{StaticResource DirLabel}"/>
                                <ComboBox x:Name="RightNeighborBox" Style="{StaticResource NeighborCombo}"/>
                            </StackPanel>

                            <!-- Middle row fallbacks -->
                            <StackPanel Grid.Row="5" Grid.Column="0">
                                <TextBlock Text="fallback" Style="{StaticResource FallbackLabel}"/>
                                <ComboBox x:Name="LeftFallbackBox" Style="{StaticResource FallbackCombo}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="5" Grid.Column="2">
                                <TextBlock Text="fallback" Style="{StaticResource FallbackLabel}"/>
                                <ComboBox x:Name="RightFallbackBox" Style="{StaticResource FallbackCombo}"/>
                            </StackPanel>

                            <!-- Bottom row: Down-Left, Down, Down-Right -->
                            <StackPanel Grid.Row="8" Grid.Column="0">
                                <TextBlock Text="Down-Left" Style="{StaticResource DirLabel}"/>
                                <ComboBox x:Name="DownLeftNeighborBox" Style="{StaticResource NeighborCombo}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="8" Grid.Column="1">
                                <TextBlock Text="Down" Style="{StaticResource DirLabel}"/>
                                <ComboBox x:Name="DownNeighborBox" Style="{StaticResource NeighborCombo}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="8" Grid.Column="2">
                                <TextBlock Text="Down-Right" Style="{StaticResource DirLabel}"/>
                                <ComboBox x:Name="DownRightNeighborBox" Style="{StaticResource NeighborCombo}"/>
                            </StackPanel>

                            <!-- Bottom row fallbacks -->
                            <StackPanel Grid.Row="9" Grid.Column="0">
                                <TextBlock Text="fallback" Style="{StaticResource FallbackLabel}"/>
                                <ComboBox x:Name="DownLeftFallbackBox" Style="{StaticResource FallbackCombo}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="9" Grid.Column="1">
                                <TextBlock Text="fallback" Style="{StaticResource FallbackLabel}"/>
                                <ComboBox x:Name="DownFallbackBox" Style="{StaticResource FallbackCombo}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="9" Grid.Column="2">
                                <TextBlock Text="fallback" Style="{StaticResource FallbackLabel}"/>
                                <ComboBox x:Name="DownRightFallbackBox" Style="{StaticResource FallbackCombo}"/>
                            </StackPanel>
                        </Grid>
                    </Expander>

                    <!-- Row 4: Action buttons -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Apply Changes" Style="{StaticResource PrimaryButton}"
                                Click="ApplyChanges_Click" Margin="0,0,8,0"/>
                        <Button Content="Reset to Default" Style="{StaticResource ActionButton}"
                                Click="ResetSelected_Click"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
