<Window x:Class="fftivc.utility.jobtreeeditor.gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:fftivc.utility.jobtreeeditor.gui"
        Title="FFT Ivalice Chronicles - Job Tree Editor"
        Width="820" Height="720"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: File controls (shared, stays outside tabs) -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBg}"
        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
        CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6"
                   Style="{StaticResource SectionLabel}" Text="FILE"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Input:"
                   Foreground="{DynamicResource TextPrimary}"
                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="InputPathBox" IsReadOnly="True"
                 VerticalAlignment="Center" Padding="4,3" FontSize="12"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="6,0,16,0"
                Style="{StaticResource ActionButton}" Click="BrowseInput_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="3" Text="Output:"
                   Foreground="{DynamicResource TextPrimary}"
                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Row="1" Grid.Column="4" x:Name="OutputPathBox"
                 VerticalAlignment="Center" Padding="4,3" FontSize="12"/>
                <Button Grid.Row="1" Grid.Column="5" Content="Browse…" Margin="6,0,0,0"
                Style="{StaticResource ActionButton}" Click="BrowseOutput_Click"/>
            </Grid>
        </Border>

        <!-- Row 1: Tab control -->
        <TabControl Grid.Row="1" Margin="0,0,0,10"
                Background="Transparent" BorderBrush="{DynamicResource PanelBorder}">

            <!-- Tab 1: Job Tree Positions (existing UIB editor) -->
            <TabItem Header="Job Tree Positions">
                <local:JobTreePositionsControl x:Name="JobTreeEditor"/>
            </TabItem>

            <!-- Tab 2: GeneralJob Editor -->
            <TabItem Header="GeneralJob Editor">
                <local:GeneralJobEditorControl x:Name="GeneralJobEditor"/>
            </TabItem>
        </TabControl>

        <!-- Row 2: Status bar (shared) -->
        <TextBlock Grid.Row="2" x:Name="StatusText" FontSize="12"
               Foreground="{DynamicResource StatusFg}" Margin="0,0,0,8"/>

        <!-- Row 3: Bottom buttons (shared) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Load Layout…" Style="{StaticResource ActionButton}"
            Margin="0,0,8,0" Click="LoadLayout_Click"/>
            <Button Content="Export Layout…" Style="{StaticResource ActionButton}"
            Margin="0,0,8,0" Click="ExportLayout_Click"/>
            <Button Content="Reset All" Style="{StaticResource ActionButton}"
            Margin="0,0,8,0" Click="ResetAll_Click"/>
            <Button Content="Save UIB" Style="{StaticResource PrimaryButton}"
            Click="Save_Click" MinWidth="100"/>
        </StackPanel>
        </Grid>
</Window>
